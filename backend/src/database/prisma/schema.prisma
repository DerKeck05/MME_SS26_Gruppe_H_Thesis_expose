generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Supervisor {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String

  // Bleibt vorerst für bestehenden Code erhalten
  chair String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  chairId       Int?
  chairRelation Chair? @relation(fields: [chairId], references: [id])

  students Student[]
  theses   Thesis[]
  courses  Course[]
  faq      Faq[]
}

model Student {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String

  // Bleibt vorerst für bestehenden Code erhalten
  course String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  courseId       Int?
  courseRelation Course? @relation(fields: [courseId], references: [id])

  supervisorId Int?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id])

  thesis Thesis?
}

model Thesis {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentId Int     @unique
  student   Student @relation(fields: [studentId], references: [id])

  supervisorId Int
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])

  calendarEntries CalendarEntry[]
  chapters        Chapter[]
}

model CalendarEntry {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id])
}

model Chapter {
  id    Int    @id @default(autoincrement())
  title String

  parentId Int?
  parent   Chapter?  @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Chapter[] @relation("ChapterHierarchy")

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id])

  feedbackEntries FeedbackEntry[]
}

model FeedbackEntry {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supervisorId Int
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])
}

model University {
  id   Int    @id @default(autoincrement())
  name String @unique

  supervisors Supervisor[]
  students    Student[]
  courses     Course[]
  chairs      Chair[]
}

model Chair {
  id           Int    @id @default(autoincrement())
  name         String
  universityId Int

  university University @relation(fields: [universityId], references: [id])

  supervisors Supervisor[]

  // Studiengänge, die diesem Lehrstuhl zugeordnet sind
  courses Course[]

  @@unique([name, universityId])
}

model Course {
  id           Int    @id @default(autoincrement())
  name         String
  universityId Int

  university University @relation(fields: [universityId], references: [id])

  supervisors Supervisor[]
  students    Student[]

  // Lehrstühle, denen dieser Studiengang zugeordnet ist
  chairs Chair[]

  @@unique([name, universityId])
}
