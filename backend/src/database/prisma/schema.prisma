// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------ Model Setup -------------

// Supervisor Model
model Supervisor {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  chair        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  // Relations
  students Student[]
  theses   Thesis[]
  courses  Course[]
  faq      Faq?
}

// Student Model
model Student {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  course       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foreign Key to University
  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  // Foreign Key to Supervisor
  supervisorId Int?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id])

  // 1:1 Relation to Thesis
  thesis Thesis?

  // Foreign Key to Course
  courseId       Int?
  courseRelation Course? @relation(fields: [courseId], references: [id])
}

// Thesis Model
model Thesis {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Key to Student
  studentId Int     @unique
  student   Student @relation(fields: [studentId], references: [id])

  // Foreign Key to Supervisor
  supervisorId Int
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])

  // Relations
  calendarEntries CalendarEntry[]
  chapters        Chapter[]
}

// CalendarEntry Model
model CalendarEntry {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Key to Thesis
  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id])
}

// Chapter Model
model Chapter {
  id    Int    @id @default(autoincrement())
  title String

  parentId Int?
  parent   Chapter?  @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Chapter[] @relation("ChapterHierarchy")

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Key to Thesis
  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id])

  // Relations
  feedbackEntries FeedbackEntry[]
}

// FeedbackEntry Model
model FeedbackEntry {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Key to Chapter
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// FAQ Model
model Faq {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Key to Supervisor
  supervisorId Int        @unique
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])
}

// University Model
model University {
  id   Int    @id @default(autoincrement())
  name String @unique

  supervisors Supervisor[]
  students    Student[]
  courses     Course[]
}

// Course Model
model Course {
  id           Int    @id @default(autoincrement())
  name         String
  universityId Int

  // Foreign Key to University
  university University @relation(fields: [universityId], references: [id])

  // Relations
  supervisors Supervisor[]
  students    Student[]

  @@unique([name, universityId])
}
